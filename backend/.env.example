[TEMPLATE]
# ZKVote Relayer Configuration

# Network Configuration
SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc
NETWORK_PASSPHRASE=Standalone Network ; February 2017
HORIZON_URL=http://localhost:8000

# Endpoint pools (#745). Comma-separated; the singular *_URL above is always a
# member. Production should list at least two independent providers each.
# SOROBAN_RPC_URLS=https://rpc-a.example,https://rpc-b.example
# HORIZON_URLS=https://horizon-a.example,https://horizon-b.example
# Anchor lists are mirrors of the SAME anchor operator, never different anchors.
# ANCHOR_USDC_URLS=https://anchor.circle.com
# ANCHOR_EURC_URLS=https://anchor.eurc.circle.com
# Shared retry / freshness policy for every pool.
# ENDPOINT_MAX_FINALITY_LAG_LEDGERS=5
# ENDPOINT_HEALTH_INTERVAL_MS=15000
# ENDPOINT_REQUEST_TIMEOUT_MS=10000
# ENDPOINT_RETRY_MAX_ATTEMPTS=3
# ENDPOINT_RETRY_BASE_MS=200
# ENDPOINT_RETRY_MAX_MS=5000
# ENDPOINT_RETRY_BUDGET_RATIO=0.2
# ENDPOINT_ARBITRATION_QUORUM=2

# Credit assets. Use the issuer for the selected network.
USDC_ISSUER=G...
EURC_ISSUER=G...

# Soroswap fallback is fail-closed unless this exact router contract is pinned.
SOROSWAP_API=https://api.soroswap.finance/quote
SOROSWAP_CONTRACT_ID=C...

# Relayer Account (automatically generated by init-local.sh)
RELAYER_SECRET_KEY=REPLACE_ME_RELAYER_SECRET

# Relayer key lifecycle (#746). Keep at least one funded standby so a
# compromise can rotate immediately instead of halting.
# RELAYER_SECONDARY_SECRET_KEY=REPLACE_ME_STANDBY_SECRET
# RELAYER_ROTATION_DRAIN_WINDOW_MS=300000      # dual-identity window (old key drains)
# RELAYER_ROTATION_MIN_FUNDING_XLM=10          # refuse cutover to an underfunded account
# RELAYER_ROTATION_FENCE_TIMEOUT_MS=30000
# RELAYER_KEY_MAX_AGE_DAYS=90                  # alert when the active key is older
# RELAYER_COMPROMISE_SLO_SECONDS=300
# RELAYER_COMPROMISE_COOLDOWN_MS=600000        # 2nd declaration inside this needs a co-signer
# RELAYER_SWEEP_SAFE_ACCOUNT=G...              # cold account; never a relayer key
# Signing tiers: CODE:HOT_MAX:WARM_MAX per asset; above WARM_MAX (or privileged ops) is cold.
# RELAYER_SIGNING_TIERS_ENABLED=true
# RELAYER_TIER_LIMITS=XLM:10000:100000,USDC:1000:10000,EURC:1000:10000,*:100:1000
# RELAYER_COSIGNER_KEYS=ops-a:REPLACE_ME_SECRET,ops-b:REPLACE_ME_SECRET
# RELAYER_BREAK_GLASS_SECRET=REPLACE_ME_AT_LEAST_32_CHARS

# Contract Addresses
VOTING_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TREE_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
COMMENTS_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DAO_REGISTRY_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MEMBERSHIP_SBT_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Anti-spam: per-member commitment registration rate limiting (#371)
# Mirrors the on-chain per-member cooldown in the membership-tree contract.
COMMITMENT_REGISTRATION_RATE_LIMIT=5
COMMITMENT_REGISTRATION_RATE_WINDOW_MS=60000

# Event Indexer Configuration
INDEXER_ENABLED=true
INDEXER_POLL_INTERVAL_MS=5000

# Server Configuration
PORT=3001

# Prometheus metrics are always available at GET /metrics.
# Restrict /metrics at the ingress/network layer in production.

# Optional OpenTelemetry OTLP/HTTP tracing. The backend sends indexer and
# service-boundary spans to this endpoint and never fails requests if export is unavailable.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=zkvote-relayer
# OTEL_SDK_DISABLED=false
# OTEL_EXPORT_TIMEOUT_MS=2000

# Authentication Master Key (REQUIRED)
AUTH_MASTER_KEY=REPLACE_ME_WITH_SECURE_MASTER_KEY_MIN_32_CHARS
RELAYER_AUTH_TOKEN=

# Salt mixed into client IP hashes (set a long random value in production)
IP_HASH_SALT=

# Bridge (optional)
# BRIDGE_CONTRACT_ID=
# BRIDGE_VKEY_PATH=./circuits/build/bridge_verification_key.json

# When true, /vote requires a real TLS client certificate on the socket
# (spoofable HTTP headers are ignored)
# REQUIRE_CLIENT_CERT=false

# CORS Configuration
# Comma-separated list of allowed origins for CORS (required in production)
# Example: CORS_ORIGINS=https://zkvote.example.com,https://app.zkvote.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# IPFS/Pinata Configuration (optional)
PINATA_JWT=
# PINATA_GATEWAY=

# IPFS Pin Redundancy (optional — enhances data durability)
# Local directory for content backups before pinning
# IPFS_BACKUP_DIR=./data/ipfs-backup
# Web3.Storage API token for secondary pinning (get at https://web3.storage)
# WEB3_STORAGE_TOKEN=
# Interval between pin verification scans in ms (default: 3600000 = 1 hour)
# PIN_VERIFY_INTERVAL_MS=3600000
# Consecutive verification failures before alerting (default: 3)
# PIN_ALERT_THRESHOLD=3
# Automatically re-pin failed content from local backup (default: true)
# PIN_AUTO_REPIN=true

# Circuit Breaker Configuration
# CIRCUIT_BREAKER_RPC_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_RPC_RESET_MS=30000
# CIRCUIT_BREAKER_PINATA_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_PINATA_RESET_MS=30000
# CIRCUIT_BREAKER_GATEWAY_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_GATEWAY_RESET_MS=30000

# Memory Monitoring
# MEMORY_MONITOR_INTERVAL_MS=60000
# MEMORY_LIMIT_MB=512
# MEMORY_WARN_RATIO=0.8
# MEMORY_CRITICAL_RATIO=0.95
# MEMORY_AUTO_RESTART=true

# Cache
# MAX_CACHED_DAOS=5000
# DB_QUERY_CACHE_MAX_ENTRIES=500

# Logging Sampling
# Sampling rate for successful requests (0.0-1.0, default: 0.1 = 10%)
# LOG_SAMPLING_RATE=0.1
# Sampling rate for error responses (default: 1.0 = 100%)
# LOG_SAMPLING_ERROR_RATE=1.0
# Sampling rate for slow requests (default: 1.0 = 100%)
# LOG_SAMPLING_SLOW_RATE=1.0
# Threshold in ms to classify as slow (default: 1000)
# LOG_SLOW_THRESHOLD_MS=1000
# Max characters from request/response bodies in logs (default: 2000)
# LOG_BODY_MAX_CHARS=2000

# Hot-Reload Settings
# HOT_RELOAD_ENABLED=false
