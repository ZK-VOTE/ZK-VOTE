# ZKVote Relayer Configuration

# Network Configuration
SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc
NETWORK_PASSPHRASE=Standalone Network ; February 2017

# Relayer Account (automatically generated by init-local.sh)
# WARNING: Keep this secret secure! Never commit to version control.
# Generate with: stellar keys generate relayer
# Fund with: stellar keys fund relayer --network local
RELAYER_SECRET_KEY=REPLACE_ME_RELAYER_SECRET

# Admin Secret Key (for set-vk scripts)
# WARNING: Keep this secret secure! Never commit to version control.
# This should be the secret key of the DAO admin
ADMIN_SECRET_KEY=REPLACE_ME_ADMIN_SECRET

# Contract Addresses (automatically set by init-local.sh)
# Get from deployment via ./scripts/deploy-local.sh
VOTING_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TREE_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
COMMENTS_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DAO_REGISTRY_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MEMBERSHIP_SBT_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Event Indexer Configuration
INDEXER_ENABLED=true
INDEXER_POLL_INTERVAL_MS=5000

# Server Configuration
PORT=3001

# Authentication Master Key (REQUIRED)
# Master key for token management endpoints (create/revoke/rotate/list tokens)
# Must be at least 32 characters. Generate with: openssl rand -hex 32
# WARNING: This key grants FULL control over all auth tokens. Keep it extremely secure.
AUTH_MASTER_KEY=REPLACE_ME_WITH_SECURE_MASTER_KEY_MIN_32_CHARS

# Legacy Authentication Token (OPTIONAL - for backward compatibility)
# Will be automatically migrated to the database on first startup.
# Prefer creating new per-client tokens via the API instead.
# Must be at least 32 characters. Generate with: openssl rand -hex 32
RELAYER_AUTH_TOKEN=

# Token Rotation Configuration
# Enable automatic token rotation (default: true)
TOKEN_ROTATION_ENABLED=true
# Rotation interval in ms (default: 30 days = 2,592,000,000 ms)
TOKEN_ROTATION_INTERVAL_MS=2592000000
# Transition/grace period in ms where both old and new tokens are valid (default: 2 days = 172,800,000 ms)
TOKEN_ROTATION_TRANSITION_MS=172800000
# Default token lifetime in ms for newly created tokens (default: 60 days = 5,184,000,000 ms)
DEFAULT_TOKEN_LIFETIME_MS=5184000000

# Token Audit Logging
# Enable/disable auth audit logging (default: true)
TOKEN_AUDIT_LOG_ENABLED=true

# CORS Configuration (optional)
# In production, set to specific frontend origin (e.g., https://app.example.com)
# Default: * (allows all origins - only use for local development)
# CORS_ORIGIN=http://localhost:3000

# IPFS/Pinata Configuration (optional - enables rich proposal content)
# Get your JWT at https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
# Optional: Custom Pinata gateway (default: gateway.pinata.cloud)
# PINATA_GATEWAY=

# IPFS Pin Redundancy (optional — enhances data durability)
# Local directory for content backups before pinning
# IPFS_BACKUP_DIR=./data/ipfs-backup
# Web3.Storage API token for secondary pinning (get at https://web3.storage)
# WEB3_STORAGE_TOKEN=
# Interval between pin verification scans in ms (default: 3600000 = 1 hour)
# PIN_VERIFY_INTERVAL_MS=3600000
# Consecutive verification failures before alerting (default: 3)
# PIN_ALERT_THRESHOLD=3
# Automatically re-pin failed content from local backup (default: true)
# PIN_AUTO_REPIN=true

# ============================================
# Encrypted Database Backups (Issue #359)
# ============================================
# Encrypt relay DB snapshots at rest / in object storage so disaster-recovery
# copies never contain plaintext (AES-256-GCM envelope encryption).
# Generate a key with: npx tsx src/backup-key-manager.ts generate
BACKUP_ENCRYPTION_ENABLED=false
# Persist the encryption key file (one base64 key per line; first line = current)
# BACKUP_ENCRYPTION_KEY_FILE=./data/backup-keys/current.key
# Directory holding keys archived on rotation (used only to decrypt old backups)
# BACKUP_KEY_RING_DIR=./data/backup-keys
# Allow one-time automatic key generation when none is configured (dev only)
# BACKUP_ENCRYPTION_AUTO_INIT=false
# Number of on-disk backups to retain (default: 10)
# BACKUP_RETENTION_COUNT=10
# Optional S3 bucket for uploading encrypted snapshots (default: zkvote-backups)
# BACKUP_S3_BUCKET=
