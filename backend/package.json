{
  "name": "zkvote-backend",
  "version": "1.0.0",
  "description": "Backend services for ZKVote: Relayer (required) and optional Proof Query Service",
  "type": "module",
  "scripts": {
    "relayer": "tsx src/index.ts",
    "dev:relayer": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "validate-profiles": "tsx scripts/validate-profiles.ts",
    "test": "RELAYER_TEST_MODE=true tsx --test test/*.test.js",
    "test:coverage": "RELAYER_TEST_MODE=true node --import tsx --test --experimental-test-coverage test/*.test.js",
    "migrate:up": "tsx src/services/migrate.ts up",
    "migrate:down": "tsx src/services/migrate.ts down",
    "migrate:status": "tsx src/services/migrate.ts status",
    "migrate:dry-run": "tsx src/services/migrate.ts dry-run",
    "docs:generate": "RELAYER_TEST_MODE=true tsx scripts/generate-openapi.ts && npm run docs:types",
    "docs:check": "RELAYER_TEST_MODE=true tsx scripts/generate-openapi.ts --check",
    "docs:types": "openapi-typescript openapi.json -o src/generated/api-types.ts",
    "db:generate-types": "kysely-codegen --dialect sqlite --url data/zkvote.db --out-file src/generated/db-types.ts"
  },
  "keywords": [
    "stellar",
    "soroban",
    "zk",
    "voting",
    "dao"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0",
    "@stellar/stellar-sdk": "^15.1.0",
    "better-sqlite3": "^12.10.0",
    "circomlibjs": "^0.1.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-slow-down": "^2.1.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.4",
    "kysely-codegen": "^0.20.0",
    "multer": "^2.1.1",
    "pinata": "^2.5.1",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "overrides": {
    "axios": "^1.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.19.43",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.1.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "globals": "^17.4.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "snarkjs": "^0.7.5",
    "supertest": "^7.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.58.0"
  }
}
