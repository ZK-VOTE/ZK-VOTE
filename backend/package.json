{
  "name": "zkvote-backend",
  "version": "1.0.0",
  "description": "Backend services for ZKVote: Relayer (required) and optional Proof Query Service",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "scripts": {
    "relayer": "tsx src/index.ts",
    "dev:relayer": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "RELAYER_TEST_MODE=true tsx --test --test-force-exit --test-concurrency=1 'test/*.test.js' 'test/*.test.ts' 'test/di/*.test.ts' 'tests/*.test.ts'",
    "test:coverage": "RELAYER_TEST_MODE=true node --import tsx --test --test-force-exit --test-concurrency=1 --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='test/**' --test-coverage-lines=80 'test/*.test.js' 'test/*.test.ts' 'test/di/*.test.ts' 'tests/*.test.ts'",
    "validate-profiles": "tsx scripts/validate-profiles.ts",
    "audit:check": "npm audit --audit-level=high",
    "sbom:generate": "node ./scripts/generate-sbom.mjs",
    "migrate:up": "tsx src/services/migrate.ts up",
    "migrate:down": "tsx src/services/migrate.ts down",
    "migrate:status": "tsx src/services/migrate.ts status",
    "migrate:dry-run": "tsx src/services/migrate.ts dry-run",
    "migrate:parity": "tsx src/services/migrate.ts parity",
    "db:benchmark": "tsx scripts/db-benchmark.ts",
    "token:create": "tsx src/token-manager.ts create",
    "token:list": "tsx src/token-manager.ts list",
    "token:revoke": "tsx src/token-manager.ts revoke",
    "token:rotate": "tsx src/token-manager.ts rotate",
    "token:audit": "tsx src/token-manager.ts audit",
    "token:maintenance": "tsx src/token-manager.ts maintenance",
    "token:migrate-legacy": "tsx src/token-manager.ts migrate-legacy",
    "token:config": "tsx src/token-manager.ts config",
    "rotate-tokens": "bash src/rotate-tokens.sh",
    "backup:key": "tsx src/backup-key-manager.ts",
    "backup:key-rotate": "bash ../scripts/rotate-backup-key.sh",
    "backup:restore-test": "tsx src/backup-key-manager.ts restore-test",
    "docs:generate": "RELAYER_TEST_MODE=true tsx scripts/generate-openapi.ts && npm run docs:types",
    "docs:check": "RELAYER_TEST_MODE=true tsx scripts/generate-openapi.ts --check",
    "docs:types": "openapi-typescript openapi.json -o src/generated/api-types.ts",
    "db:generate-types": "kysely-codegen --dialect sqlite --url data/zkvote.db --out-file src/generated/db-types.ts"
  },
  "keywords": [
    "stellar",
    "soroban",
    "zk",
    "voting",
    "dao"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@noble/curves": "1.8.0",
    "@noble/hashes": "1.7.0",
    "@stellar/stellar-sdk": "15.1.0",
    "better-sqlite3": "12.10.0",
    "circomlibjs": "0.1.7",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "8.3.2",
    "express-slow-down": "2.1.0",
    "helmet": "8.2.0",
    "kysely": "0.29.4",
    "kysely-codegen": "0.20.0",
    "multer": "2.1.1",
    "pinata": "2.5.1",
    "prom-client": "15.1.3",
    "swagger-ui-express": "5.0.1",
    "zod": "3.25.76"
  },
  "overrides": {
    "axios": "1.16.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "7.6.11",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/multer": "1.4.12",
    "@types/node": "20.0.0",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "10.1.0",
    "eslint-plugin-jsdoc": "62.9.0",
    "globals": "17.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.1",
    "snarkjs": "0.7.5",
    "supertest": "7.1.4",
    "tsx": "4.7.0",
    "typescript": "5.3.0",
    "typescript-eslint": "8.58.0"
  }
}
