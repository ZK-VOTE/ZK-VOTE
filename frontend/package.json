{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
    "scripts": {
    "sync:circuits": "mkdir -p public/circuits/comment && [ -f ../circuits/build/vote_js/vote.wasm ] && cp ../circuits/build/vote_js/vote.wasm public/circuits/vote.wasm; [ -f ../circuits/build/comment_js/comment.wasm ] && cp ../circuits/build/comment_js/comment.wasm public/circuits/comment/comment.wasm; echo 'circuits synced'",
    "predev": "npm run sync:circuits",
    "dev": "vite",
    "prebuild": "npm run sync:circuits",
    "build": "tsc -b && vite build",
    "check:idl-drift": "node --experimental-strip-types scripts/check-idl-drift.ts",
    "generate:types": "node --experimental-strip-types scripts/check-idl-drift.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "drift:check": "node ../scripts/drift-guard.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^1.9.5",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@stellar/design-system": "^3.2.5",
    "@stellar/stellar-sdk": "^14.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.12",
    "@uiw/react-md-editor": "^4.0.8",
    "circomlibjs": "^0.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.555.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "rehype-external-links": "^3.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "snarkjs": "^0.7.5",
    "tailwind-merge": "^3.4.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/snarkjs": "^0.7.9",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.20",
    "buffer": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.2.0",
    "postcss": "^8.4.49",
    "prettier": "^3.8.1",
    "process": "^0.11.10",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.14"
  }
}
