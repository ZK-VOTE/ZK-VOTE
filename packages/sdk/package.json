{
  "name": "@zkvote/sdk",
  "version": "2.0.0",
  "description": "ZKVote Proving SDK - Zero-knowledge proof generation and verification",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "workers",
    "manifests",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "manifest:generate": "node scripts/generate-manifest.mjs",
    "manifest:verify": "node scripts/verify-manifest.mjs",
    "check:compatibility": "node scripts/check-compatibility.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check:compatibility && npm run build && npm run manifest:generate && npm run manifest:verify && npm run test",
    "publish:dry-run": "npm publish --dry-run"
  },
  "keywords": [
    "zero-knowledge",
    "zk-snark",
    "groth16",
    "voting",
    "privacy",
    "stellar",
    "soroban"
  ],
  "author": "ZKVote Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZK-VOTE/ZK-VOTE.git",
    "directory": "packages/sdk"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "circomlibjs": "^0.1.7",
    "snarkjs": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
